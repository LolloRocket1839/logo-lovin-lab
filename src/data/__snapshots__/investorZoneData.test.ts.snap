// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`investorZoneData — error report snapshots > collectInvestorZoneIssues() returns a stable issue shape 1`] = `
[
  {
    "code": "invalid_type",
    "index": 0,
    "message": "Required",
    "path": "investorNote",
    "received": "undefined",
  },
  {
    "code": "invalid_type",
    "index": 1,
    "message": "Expected number, received string",
    "path": "coordinates.lat",
    "received": ""not-a-number"",
  },
]
`;

exports[`investorZoneData — error report snapshots > empty-issues output is stable 1`] = `"[investorZoneData] ✓ no invalid fields"`;

exports[`investorZoneData — error report snapshots > empty-issues output is stable 2`] = `"[investorZoneData] ✓ all zones valid"`;

exports[`investorZoneData — error report snapshots > formatInvestorZoneReport() output is stable 1`] = `
